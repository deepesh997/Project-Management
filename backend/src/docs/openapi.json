{
  "openapi": "3.0.3",
  "info": {
    "title": "WorkSphere Enterprise Multi-Tenant Core API",
    "version": "1.0.0",
    "description": "Multi-Tenant Project Management & Workflow Automation REST API with Optimistic Concurrency Control (OCC), HMAC-SHA256 Webhooks, and Role-Based Access Control (RBAC)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Host / Development Gateway"
    },
    {
      "url": "https://project-management-d5cv.onrender.com",
      "description": "Production Render Live Cluster"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Standard RFC 7519 JSON Web Token issued by /api/v1/auth/token or /api/v1/auth/register"
      },
      "TenantIsolation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Tenant-ID",
        "description": "Tenant Context Header enforcing strict server-side multi-tenant boundary isolation"
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "task-103" },
          "projectId": { "type": "string", "example": "proj-acme-alpha" },
          "orgId": { "type": "string", "example": "org-acme-101" },
          "title": { "type": "string", "example": "HMAC Webhook Ingestion & Replay Protection" },
          "description": { "type": "string", "example": "Verify SHA256 HMAC signatures with 300-second timestamp tolerance." },
          "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "IN_REVIEW", "DONE", "BLOCKED"], "example": "TODO" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"], "example": "MEDIUM" },
          "assigneeId": { "type": "string", "nullable": true, "example": "usr-member-1" },
          "creatorId": { "type": "string", "example": "usr-pm-1" },
          "estimatedHours": { "type": "number", "example": 8 },
          "actualHours": { "type": "number", "example": 0 },
          "version": { "type": "integer", "example": 1, "description": "Atomic OCC version counter" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Subtask": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "sub-101" },
          "taskId": { "type": "string", "example": "task-103" },
          "orgId": { "type": "string", "example": "org-acme-101" },
          "title": { "type": "string", "example": "Generate SHA256 HMAC test fixtures" },
          "isCompleted": { "type": "boolean", "example": true },
          "createdBy": { "type": "string", "example": "usr-pm-1" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "com-101" },
          "taskId": { "type": "string", "example": "task-103" },
          "orgId": { "type": "string", "example": "org-acme-101" },
          "content": { "type": "string", "example": "Tested against Stripe webhook fixtures." },
          "authorId": { "type": "string", "example": "usr-pm-1" },
          "authorName": { "type": "string", "example": "Marcus Brody (PM)" },
          "authorEmail": { "type": "string", "example": "pm@acme.com" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "OCCConflictError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "CONCURRENCY_CONFLICT" },
              "message": { "type": "string", "example": "Stale update rejected. Another user has modified this task since you loaded it." },
              "currentVersion": { "type": "integer", "example": 2 },
              "attemptedVersion": { "type": "integer", "example": 1 },
              "diff": { "type": "object" },
              "resolutionAdvice": { "type": "string", "example": "Reload latest version or review differences before resubmitting." }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": [],
      "TenantIsolation": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness Probe",
        "description": "Returns service health and current UTC timestamp.",
        "security": [],
        "responses": {
          "200": { "description": "Service is healthy and responsive." }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness Probe",
        "description": "Verifies database, redis, and queue worker readiness.",
        "security": [],
        "responses": {
          "200": { "description": "All backend dependencies are active and ready." }
        }
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "summary": "Issue JWT Authentication Token",
        "description": "Authenticates user credentials and issues signed JWT bearer token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "pm@acme.com" },
                  "password": { "type": "string", "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token successfully issued." },
          "401": { "description": "Invalid credentials." }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "summary": "List Tasks",
        "description": "Returns tenant-scoped tasks filtered by project, assignee, or status.",
        "parameters": [
          { "name": "projectId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated task list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
                    "meta": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Task",
        "description": "Creates a new task in current organization with version = 1 and triggers notification job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["projectId", "title"],
                "properties": {
                  "projectId": { "type": "string", "example": "proj-acme-alpha" },
                  "title": { "type": "string", "example": "Deploy Production Hotfix" },
                  "description": { "type": "string" },
                  "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "IN_REVIEW", "DONE", "BLOCKED"] },
                  "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Task created." }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "summary": "Get Task by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Task details." },
          "404": { "description": "Task not found." }
        }
      },
      "put": {
        "summary": "Update Task with Optimistic Concurrency Control (OCC)",
        "description": "Updates task attributes atomically. If expectedVersion does not match the database version, returns HTTP 409 Conflict with state diff.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["expectedVersion"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "status": { "type": "string" },
                  "priority": { "type": "string" },
                  "expectedVersion": { "type": "integer", "description": "Current known version counter" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task updated successfully; version incremented." },
          "409": {
            "description": "Concurrency Conflict Intercepted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OCCConflictError" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Task",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Task deleted." }
        }
      }
    },
    "/api/v1/tasks/{id}/subtasks": {
      "get": {
        "summary": "List Task Subtasks",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Subtask" } }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add Subtask to Task",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "example": "Write unit tests for Redis cache" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Subtask created." }
        }
      }
    },
    "/api/v1/tasks/{id}/subtasks/{subtaskId}/toggle": {
      "patch": {
        "summary": "Toggle Subtask Completion",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "subtaskId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Subtask completion state inverted." }
        }
      }
    },
    "/api/v1/tasks/{id}/subtasks/{subtaskId}": {
      "delete": {
        "summary": "Delete Subtask",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "subtaskId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Subtask deleted." }
        }
      }
    },
    "/api/v1/tasks/{id}/comments": {
      "get": {
        "summary": "Get Task Comments Discussion",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Team Comment",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "example": "PR is ready for review on branch main." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Comment added." }
        }
      }
    },
    "/api/v1/tasks/{id}/comments/{commentId}": {
      "delete": {
        "summary": "Delete Comment",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Comment removed." }
        }
      }
    },
    "/api/v1/tasks/{id}/activity": {
      "get": {
        "summary": "Get Task Activity & Submission Audit Log",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Task activity audit log history." }
        }
      },
      "post": {
        "summary": "Submit Work Progress Note / Hours",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["note"],
                "properties": {
                  "note": { "type": "string", "example": "Completed unit testing with 100% code coverage." },
                  "status": { "type": "string" },
                  "hoursSpent": { "type": "number", "example": 2.5 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Work logged to immutable audit trail." }
        }
      }
    },
    "/api/v1/integrations/webhooks/incoming": {
      "post": {
        "summary": "Ingest Inbound Webhook with HMAC-SHA256 Verification",
        "description": "Verifies X-WorkSphere-Signature with 300s timestamp drift protection and deduplication.",
        "parameters": [
          { "name": "X-WorkSphere-Signature", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "X-WorkSphere-Timestamp", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Webhook ingested and processed." },
          "401": { "description": "HMAC signature mismatch or timestamp drift > 300s." }
        }
      }
    }
  }
}
