# WorkSphere Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO REPOSITORY

NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000
ANALYTICS_PORT=8000

# Database Configuration
DATABASE_URL=postgresql://worksphere_user:your_secure_db_password_here@postgres:5432/worksphere
POSTGRES_DB=worksphere
POSTGRES_USER=worksphere_user
POSTGRES_PASSWORD=your_secure_db_password_here

# Redis Cache & Message Broker
REDIS_URL=redis://redis:6379

# Security & Authentication Secrets
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_refresh_token_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Microservice & Webhook Authentication
WEBHOOK_SECRET=whsec_replace_with_hex_encoded_webhook_secret
ANALYTICS_SERVICE_URL=http://analytics:8000
ANALYTICS_API_KEY=replace_with_internal_service_api_key

# Third-Party Integrations (Sandbox Credentials)
SMTP_HOST=smtp.sandbox.worksphere.internal
SMTP_PORT=587
SMTP_USER=sandbox-user
SMTP_PASS=sandbox-pass
S3_BUCKET_NAME=worksphere-attachments-sandbox
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=placeholder_s3_key
S3_SECRET_ACCESS_KEY=placeholder_s3_secret
